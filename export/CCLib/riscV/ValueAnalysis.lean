/-
  [RISC-V instance of `CCLib/backend/ValueAnalysis.lean`: the same development, in
  namespace `CC.RiscV`, over the RISC-V operators, registers and conventions.]

  The value analysis over RTL — port of the analysis part of
  `backend/ValueAnalysis.v`.

  Ported: `areg`, `aregs`, `mafter_public_call`, `mafter_private_call`,
  `analyze_call`, `transfer_call`, `abuiltin_arg`, `set_builtin_res`,
  `transfer_builtin_default`, `eval_static_builtin_function`,
  `transfer_builtin`, `transfer`, `transfer'`, `mfunction_entry`,
  `analyze` (the forward dataflow solver `DS` instantiated at `VA`),
  `store_init_data`, `store_init_data_list`, `definitive_initializer`,
  `alloc_global`, `romem_for`, `bc_nostack`, `avalue`, `aaddr`,
  `aaddressing`, `aaddr_arg`.

  The semantic invariant (`sound_stack`, `sound_state`, …) and the soundness
  proof of the analysis are in `ValueAnalysisSound*.lean`
  (`sound_step_base` in `ValueAnalysisSoundBuiltin.lean`; `sound_initial`,
  `sound_step` and the interface lemmas in `ValueAnalysisSoundInit.lean`).

  Differences from Rocq: `Compopts.va_strict`,
  `Compopts.propagate_float_constants` and `Archi.abi` are explicit
  arguments (`ValueAOp.Options`, `abi`).  The dataflow lattice `VA` is
  `ValueDomain.VA.lat`, whose order is generated by its operations (see
  `LatticeFree.lean`).
-/
import CCLib.riscV.ValueAOp
import CCLib.backend.ValueDomainMem
import CCLib.riscV.Liveness
import CCLib.common.Builtins

namespace CC
namespace RiscV
namespace ValueAnalysis

open ValueDomain RTL

section
variable (o : ValueAOp.Options)

/-- `ValueAnalysis.areg` -/
def areg (ae : Aenv) (r : Reg) : Aval := AE.get r ae

/-- `ValueAnalysis.aregs` -/
def aregs (ae : Aenv) (rl : List Reg) : List Aval := rl.map (areg ae)

/-- `ValueAnalysis.mafter_public_call` -/
def mafterPublicCall : Amem := mtop

/-- `ValueAnalysis.mafter_private_call` -/
def mafterPrivateCall (amBefore : Amem) : Amem :=
  { am_stack := amBefore.am_stack, am_glob := PTree.empty, am_nonstack := .Nonstack,
    am_top := plub amBefore.am_stack.ab_summary .Nonstack }

/-- `ValueAnalysis.analyze_call`: calls that let no pointer to the
    current stack frame escape are treated specially. -/
def analyzeCall (am : Amem) (aargs : List Aval) : Aval × Amem :=
  if pincl am.am_nonstack .Nonstack && aargs.all (fun av => vpincl av .Nonstack)
  then (.Ifptr .Nonstack, mafterPrivateCall am)
  else (Vtop, mafterPublicCall)

/-- `ValueAnalysis.transfer_call` -/
def transferCall (ae : Aenv) (am : Amem) (args : List Reg) (res : Reg) : VAState :=
  let (av, am') := analyzeCall am (aregs ae args)
  .State (AE.set res av ae) am'

/-- `ValueAnalysis.abuiltin_arg` -/
def abuiltinArg (ae : Aenv) (am : Amem) (rm : Romem) : BuiltinArg Reg → Aval
  | .BA r => areg ae r
  | .BA_int n => .I n
  | .BA_long n => .L n
  | .BA_float n => .F n
  | .BA_single n => .FS n
  | .BA_loadstack chunk ofs => loadv o.strict chunk rm am (.Ptr (.Stk ofs))
  | .BA_addrstack ofs => .Ptr (.Stk ofs)
  | .BA_loadglobal chunk id ofs => loadv o.strict chunk rm am (.Ptr (.Gl id ofs))
  | .BA_addrglobal id ofs => .Ptr (.Gl id ofs)
  | .BA_splitlong hi lo => longofwords (abuiltinArg ae am rm hi) (abuiltinArg ae am rm lo)
  | .BA_addptr ba1 ba2 =>
      let v1 := abuiltinArg ae am rm ba1
      let v2 := abuiltinArg ae am rm ba2
      if Archi.ptr64 then addl v1 v2 else add v1 v2

/-- `ValueAnalysis.set_builtin_res` -/
def setBuiltinRes (br : BuiltinRes Reg) (av : Aval) (ae : Aenv) : Aenv :=
  match br with
  | .BR r => AE.set r av ae
  | _ => ae

/-- `ValueAnalysis.transfer_builtin_default` -/
def transferBuiltinDefault (ae : Aenv) (am : Amem) (rm : Romem) (args : List (BuiltinArg Reg))
    (res : BuiltinRes Reg) : VAState :=
  let (av, am') := analyzeCall am (args.map (abuiltinArg o ae am rm))
  .State (setBuiltinRes res av ae) am'

/-- `ValueAnalysis.eval_static_builtin_function` -/
def evalStaticBuiltinFunction (ae : Aenv) (am : Amem) (rm : Romem) (bf : Builtins.BuiltinFunction)
    (args : List (BuiltinArg Reg)) : Option Aval :=
  match (Builtins.builtinFunctionSem bf).sem ((args.map (abuiltinArg o ae am rm)).map valOfAval) with
  | some v => avalOfVal v
  | none => none

/-- `ValueAnalysis.transfer_builtin` -/
def transferBuiltin (ae : Aenv) (am : Amem) (rm : Romem) (ef : ExtFun)
    (args : List (BuiltinArg Reg)) (res : BuiltinRes Reg) : VAState :=
  match ef, args with
  | .EF_vload chunk, [addr] =>
      let aaddr := abuiltinArg o ae am rm addr
      let a := if o.strict
        then vlub o.strict (loadv o.strict chunk rm am aaddr) (vnormalize chunk (.Ifptr .Glob))
        else vnormalize chunk Vtop
      .State (setBuiltinRes res a ae) am
  | .EF_vstore chunk, [addr, v] =>
      let aaddr := abuiltinArg o ae am rm addr
      let av := abuiltinArg o ae am rm v
      let am' := storev o.strict chunk am aaddr av
      .State (setBuiltinRes res ntop ae) (mlub o.strict am am')
  | .EF_memcpy sz _, [dst, src] =>
      let adst := abuiltinArg o ae am rm dst
      let asrc := abuiltinArg o ae am rm src
      let p := loadbytes o.strict am rm (aptrOfAval o.strict asrc)
      let am' := storebytes am (aptrOfAval o.strict adst) sz p
      .State (setBuiltinRes res ntop ae) am'
  | .EF_annot _ _ _, _ | .EF_debug _ _ _, _ => .State (setBuiltinRes res ntop ae) am
  | .EF_annot_val _ _ _, [v] =>
      let av := abuiltinArg o ae am rm v
      .State (setBuiltinRes res av ae) am
  | .EF_builtin name sg, _ =>
      match Builtins.lookupBuiltinFunction name sg with
      | some bf =>
          match evalStaticBuiltinFunction o ae am rm bf args with
          | some av => .State (setBuiltinRes res av ae) am
          | none => transferBuiltinDefault o ae am rm args res
      | none => transferBuiltinDefault o ae am rm args res
  | _, _ => transferBuiltinDefault o ae am rm args res

/-- `ValueAnalysis.transfer`: the abstract state after the instruction at
    `pc`, given the abstract state `(ae, am)` before it. -/
def transfer (f : RTL.Function) (rm : Romem) (pc : Node) (ae : Aenv) (am : Amem) : VAState :=
  match f.fn_code.get pc with
  | none => .Bot
  | some (.Inop _) => .State ae am
  | some (.Iop op args res _) =>
      let a := ValueAOp.evalStaticOperation o op (aregs ae args)
      .State (AE.set res a ae) am
  | some (.Iload chunk addr args dst _) =>
      let a := loadv o.strict chunk rm am (ValueAOp.evalStaticAddressing addr (aregs ae args))
      .State (AE.set dst a ae) am
  | some (.Istore chunk addr args src _) =>
      let am' := storev o.strict chunk am
        (ValueAOp.evalStaticAddressing addr (aregs ae args)) (areg ae src)
      .State ae am'
  | some (.Icall _ _ args res _) => transferCall ae am args res
  | some (.Itailcall _ _ _) => .Bot
  | some (.Ibuiltin ef args res _) => transferBuiltin o ae am rm ef args res
  | some (.Icond _ _ _ _) => .State ae am
  | some (.Ijumptable _ _) => .State ae am
  | some (.Ireturn _) => .Bot

/-- `ValueAnalysis.transfer'`: `transfer`, then forget the registers that
    are dead after `pc`. -/
def transfer' (f : RTL.Function) (lastuses : PTree (List Reg)) (rm : Romem) (pc : Node)
    (before : VAState) : VAState :=
  match before with
  | .Bot => .Bot
  | .State ae am =>
      match transfer o f rm pc ae am with
      | .Bot => .Bot
      | .State ae' am' =>
          let ae'' := match lastuses.get pc with
            | none => ae'
            | some regs => eforget regs ae'
          .State ae'' am'

/-- `ValueAnalysis.mfunction_entry` -/
def mfunctionEntry : Amem :=
  { am_stack := ablockInit .Pbot, am_glob := PTree.empty, am_nonstack := .Nonstack,
    am_top := .Nonstack }

/-- `ValueAnalysis.analyze`: the forward dataflow analysis
    (`DS := Dataflow_Solver(VA)(NodeSetForward)`). -/
def analyze (rm : Romem) (f : RTL.Function) : PMap VAState :=
  let lu := Liveness.lastUses f
  let entry := VAState.State (einitRegs .Apple f.fn_params f.fn_sig.sig_args) mfunctionEntry
  letI : Semilattice VAState := VA.lat o.strict
  match Kildall.fixpoint (L := VAState) (NS := NodeSetForward) f.fn_code successorsInstr
      (transfer' o f lu rm) f.fn_entrypoint entry with
  | none => PMap.init (.State AE.top mtop)
  | some res => res

/-! ## The approximation of read-only globals -/

/-- `ValueAnalysis.store_init_data` -/
def storeInitData (ab : Ablock) (p : Z) (id : InitData) : Ablock :=
  match id with
  | .Init_int8 n => ablockStore .Mint8unsigned ab p (.I n)
  | .Init_int16 n => ablockStore .Mint16unsigned ab p (.I n)
  | .Init_int32 n => ablockStore .Mint32 ab p (.I n)
  | .Init_int64 n => ablockStore .Mint64 ab p (.L n)
  | .Init_float32 n => ablockStore .Mfloat32 ab p (if o.propagateFloatConstants then .FS n else ntop)
  | .Init_float64 n => ablockStore .Mfloat64 ab p (if o.propagateFloatConstants then .F n else ntop)
  | .Init_addrof symb ofs => ablockStore Mptr ab p (.Ptr (.Gl symb ofs))
  | .Init_space _ => ab

/-- `ValueAnalysis.store_init_data_list` -/
def storeInitDataList : Ablock → Z → List InitData → Ablock
  | ab, _, [] => ab
  | ab, p, id :: idl' => storeInitDataList (storeInitData o ab p id) (p + id.size) idl'

end

/-- `ValueAnalysis.definitive_initializer`: in separate compilation, an
    `extern const` (no initializer) or a common `const` symbol may be
    initialized in another unit. -/
def definitiveInitializer (init : List InitData) : Bool :=
  match init with
  | [] => false
  | [.Init_space _] => false
  | _ => true

/-- `ValueAnalysis.alloc_global` -/
def allocGlobal (o : ValueAOp.Options) (rm : Romem) (idg : Ident × GlobDef RTL.Fundef Unit) :
    Romem :=
  match idg with
  | (id, .Gfun _) => rm.remove id
  | (id, .Gvar v) =>
      if v.gvar_readonly && !v.gvar_volatile && definitiveInitializer v.gvar_init
      then rm.set id (storeInitDataList o (ablockInit .Pbot) 0 v.gvar_init)
      else rm.remove id

/-- `ValueAnalysis.romem_for` -/
def romemFor (o : ValueAOp.Options) (p : RTL.Program) : Romem :=
  p.prog_defs.foldl (allocGlobal o) PTree.empty

/-- `ValueAnalysis.bc_nostack` -/
def BcNostack (bc : BlockClassification) : Prop := ∀ b, bc b ≠ .BCstack

/-! ## Abstract values at a program point (used by CSE) -/

section
variable (o : ValueAOp.Options)

/-- `ValueAnalysis.avalue` -/
def avalue (a : VAState) (r : Reg) : Aval :=
  match a with
  | .Bot => .Vbot
  | .State ae _ => AE.get r ae

/-- `ValueAnalysis.aaddr` -/
def aaddr (a : VAState) (r : Reg) : Aptr :=
  match a with
  | .Bot => .Pbot
  | .State ae _ => aptrOfAval o.strict (AE.get r ae)

/-- `ValueAnalysis.aaddressing` -/
def aaddressing (a : VAState) (addr : Op.Addressing) (args : List Reg) : Aptr :=
  match a with
  | .Bot => .Pbot
  | .State ae _ => aptrOfAval o.strict (ValueAOp.evalStaticAddressing addr (aregs ae args))

/-- `ValueAnalysis.aaddr_arg` -/
def aaddrArg (a : VAState) (ba : BuiltinArg Reg) : Aptr :=
  match a with
  | .Bot => .Pbot
  | .State ae _ =>
      match ba with
      | .BA r => aptrOfAval o.strict (AE.get r ae)
      | .BA_addrstack ofs => .Stk ofs
      | .BA_addrglobal id ofs => .Gl id ofs
      | _ => .Ptop

end

end ValueAnalysis
end RiscV
end CC
