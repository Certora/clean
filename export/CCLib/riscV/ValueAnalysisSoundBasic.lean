/-
  [RISC-V instance of `CCLib/backend/ValueAnalysisSoundBasic.lean`: the same development, in
  namespace `CC.RiscV`, over the RISC-V operators, registers and conventions.]

  Soundness of the value analysis, part 1 — port of `backend/ValueAnalysis.v`
  from "Properties of the dataflow solution" to section `NOSTACK`.

  Ported: `analyze_entrypoint`, `analyze_successor`, `analyze_succ`,
  `areg_sound`, `aregs_sound`, `abuiltin_arg_sound`, `abuiltin_args_sound`,
  `set_builtin_res_sound`, `eval_static_builtin_function_sound`,
  `pmatch_no_stack`, `vmatch_no_stack`, `smatch_no_stack`, `mmatch_no_stack`.

  Differences from Rocq: the dataflow lattice used by `analyze` carries the
  free order generated by its operations; `VA.ge_of_free` converts the
  solver's guarantees to the semantic order `VA.ge`.
-/
import CCLib.riscV.ValueAnalysis
import CCLib.backend.ValueDomainEnv
import CCLib.backend.ValueDomainInj
import CCLib.riscV.ValueAOp
import CCLib.common.EventsBuiltinArgs

namespace CC
namespace RiscV
namespace ValueAnalysis

open ValueDomain RTL

section
variable (o : ValueAOp.Options)

omit o in
/-- The RISC-V `RTL.init_regs` is the same function as the shared one used by
    `ValueDomain.ematch_init`. -/
theorem initRegs_eq_shared : ∀ (vl : List Val) (rl : List Reg),
    RTL.initRegs vl rl = CC.RTL.initRegs vl rl
  | _ :: vs, _ :: rs => by simp only [RTL.initRegs, CC.RTL.initRegs, initRegs_eq_shared vs rs]
  | [], _ => rfl
  | _ :: _, [] => rfl

/-! ## Properties of the dataflow solution -/

/-- `ValueAnalysis.analyze_entrypoint` -/
theorem analyze_entrypoint (rm : Romem) (f : RTL.Function) {vl : List Val} {m : Mem}
    {bc : BlockClassification} (hv : ∀ v, v ∈ vl → Vmatch bc v (.Ifptr .Nonstack))
    (ht : Val.HasArgtypeList vl f.fn_sig.sig_args) (hm : Mmatch bc m mfunctionEntry) :
    ∃ ae am, (analyze o  rm f).get f.fn_entrypoint = .State ae am ∧
      Ematch bc (initRegs vl f.fn_params) ae ∧ Mmatch bc m am := by
  have EM : Ematch bc (initRegs vl f.fn_params)
      (einitRegs .Apple f.fn_params f.fn_sig.sig_args) := by
    rw [initRegs_eq_shared]; exact ematch_init (bc := bc) .Apple f.fn_params vl f.fn_sig.sig_args ht hv
  simp only [analyze]
  split
  · refine ⟨AE.top, mtop, PMap.gi _ _, ?_, mmatch_top' hm⟩
    intro r
    exact vmatch_ge (by simp only [AE.top, AE.get, PTree.gempty]; exact vge_top _) (EM r)
  · rename_i res FIX
    have A := VA.ge_of_free (@Kildall.fixpoint_entry VAState NodeSetForward (VA.lat o.strict)
      _ _ _ _ _ _ _ _ FIX)
    revert A
    cases res.get f.fn_entrypoint with
    | Bot => intro A; exact A.elim
    | State ae am =>
      intro A
      exact ⟨ae, am, rfl, ematch_ge EM A.1, A.2 bc m hm⟩

/-- `ValueAnalysis.analyze_successor` -/
theorem analyze_successor {rm : Romem} {f : RTL.Function} {n : Node} {ae : Aenv} {am : Amem}
    {instr : Instruction} {s : Node} {ae' : Aenv} {am' : Amem}
    (hn : (analyze o  rm f).get n = .State ae am) (hcode : f.fn_code.get n = some instr)
    (hs : s ∈ successorsInstr instr) (ht : transfer o f rm n ae am = .State ae' am') :
    VA.Ge ((analyze o  rm f).get s) (transfer o f rm n ae am) := by
  simp only [analyze] at hn ⊢
  split at hn
  · rw [ht, PMap.gi]
    exact ⟨fun p => by simp only [AE.top, AE.get, PTree.gempty]; exact vge_top _,
      fun bc m h => mmatch_top' h⟩
  · rename_i res FIX
    have A := VA.ge_of_free (@Kildall.fixpoint_solution VAState NodeSetForward (VA.lat o.strict)
      _ _ _ _ _ _ _ _ _ _ _ FIX hcode hs
      (fun _ => Semilattice.FreeEq.refl _))
    rw [hn] at A
    simp only [transfer'] at A
    rw [ht] at A ⊢
    revert A
    cases (Liveness.lastUses f).get n with
    | none => exact id
    | some regs =>
      intro A
      exact VA.ge_trans A ⟨eforget_ge regs ae', fun _ _ h => h⟩

/-- `ValueAnalysis.analyze_succ` -/
theorem analyze_succ {e : RTL.Regset} {m : Mem} {rm : Romem} {f : RTL.Function} {n : Node}
    {ae : Aenv} {am : Amem} {instr : Instruction} {s : Node} {ae' : Aenv} {am' : Amem}
    {bc : BlockClassification}
    (hn : (analyze o  rm f).get n = .State ae am) (hcode : f.fn_code.get n = some instr)
    (hs : s ∈ successorsInstr instr) (ht : transfer o f rm n ae am = .State ae' am')
    (he : Ematch bc e ae') (hm : Mmatch bc m am') :
    ∃ ae'' am'', (analyze o  rm f).get s = .State ae'' am'' ∧
      Ematch bc e ae'' ∧ Mmatch bc m am'' := by
  have A := analyze_successor o  hn hcode hs ht
  rw [ht] at A
  revert A
  cases (analyze o  rm f).get s with
  | Bot => intro A; exact A.elim
  | State ae'' am'' =>
    intro A
    exact ⟨ae'', am'', rfl, ematch_ge he A.1, A.2 bc m hm⟩

end

/-! ## Analysis of registers and builtin arguments -/

section
variable {bc : BlockClassification}

/-- `ValueAnalysis.areg_sound` -/
theorem areg_sound {e : RTL.Regset} {ae : Aenv} (h : Ematch bc e ae) (r : Reg) :
    Vmatch bc (e.get r) (areg ae r) := h r

/-- `ValueAnalysis.aregs_sound` -/
theorem aregs_sound {e : RTL.Regset} {ae : Aenv} (h : Ematch bc e ae) :
    ∀ (rl : List Reg), ListForall2 (Vmatch bc) (e.getList rl) (aregs ae rl)
  | [] => .nil
  | r :: rl => .cons (areg_sound h r) (aregs_sound h rl)

variable (o : ValueAOp.Options)

/-- `ValueAnalysis.abuiltin_arg_sound` -/
theorem abuiltin_arg_sound {F V : Type} {ge : Genv F V} {rs : RTL.Regset} {sp : Block} {m : Mem}
    {ae : Aenv} {rm : Romem} {am : Amem}
    (EM : Ematch bc rs ae) (RM : Romatch bc m rm) (MM : Mmatch bc m am) (GM : GenvMatch bc ge)
    (SP : bc sp = .BCstack) {a : BuiltinArg Reg} {v : Val}
    (h : EvalBuiltinArg ge.toSenv (fun r => rs.get r) (.Vptr sp Integers.Ptrofs.zero) m a v) :
    Vmatch bc v (abuiltinArg o ae am rm a) := by
  induction h with
  | BA x => exact EM x
  | BA_int n => exact .i n
  | BA_long n => exact .l n
  | BA_float n => exact .f n
  | BA_single n => exact .s n
  | BA_loadstack chunk ofs v hl =>
    exact loadv_sound o.strict hl RM MM (ValueAOp.addrstack_sound SP ofs)
  | BA_addrstack ofs => exact ValueAOp.addrstack_sound SP ofs
  | BA_loadglobal chunk id ofs v hl =>
    exact loadv_sound o.strict hl RM MM (symbol_address_sound id ofs GM)
  | BA_addrglobal id ofs => exact symbol_address_sound id ofs GM
  | BA_splitlong hi lo vhi vlo _ _ ih1 ih2 => exact longofwords_sound ih1 ih2
  | BA_addptr a1 a2 v1 v2 _ _ ih1 ih2 =>
    simp only [abuiltinArg, Archi.ptr64, if_true]
    exact addl_sound ih1 ih2

/-- `ValueAnalysis.abuiltin_args_sound` -/
theorem abuiltin_args_sound {F V : Type} {ge : Genv F V} {rs : RTL.Regset} {sp : Block} {m : Mem}
    {ae : Aenv} {rm : Romem} {am : Amem}
    (EM : Ematch bc rs ae) (RM : Romatch bc m rm) (MM : Mmatch bc m am) (GM : GenvMatch bc ge)
    (SP : bc sp = .BCstack) {al : List (BuiltinArg Reg)} {vl : List Val}
    (h : EvalBuiltinArgs ge.toSenv (fun r => rs.get r) (.Vptr sp Integers.Ptrofs.zero) m al vl) :
    ListForall2 (Vmatch bc) vl (al.map (abuiltinArg o ae am rm)) := by
  induction h with
  | nil => exact .nil
  | cons ha _ ih => exact .cons (abuiltin_arg_sound o EM RM MM GM SP ha) ih

/-- `ValueAnalysis.set_builtin_res_sound` -/
theorem set_builtin_res_sound {rs : RTL.Regset} {ae : Aenv} {v : Val} {av : Aval}
    (res : BuiltinRes Reg) (EM : Ematch bc rs ae) (hv : Vmatch bc v av) :
    Ematch bc (regmapSetres res v rs) (setBuiltinRes res av ae) := by
  cases res with
  | BR r => exact ematch_update r EM hv
  | _ => exact EM

theorem list_val_of_aval_sound :
    ∀ {vl : List Val} {al : List Aval}, ListForall2 (Vmatch bc) vl al →
      Val.LessdefList (al.map valOfAval) vl
  | _, _, .nil => .nil
  | _, _, .cons h hl => .cons (val_of_aval_sound h) (list_val_of_aval_sound hl)

theorem lessdefList_injectList {vl vl' : List Val} (h : Val.LessdefList vl vl') :
    Val.InjectList Val.inject_id vl vl' := by
  induction h with
  | nil => exact .nil
  | cons h _ ih => exact .cons (Val.lessdef_inject_id.mp h) ih

/-- `ValueAnalysis.eval_static_builtin_function_sound` -/
theorem eval_static_builtin_function_sound {F V : Type} {ge : Genv F V} {rs : RTL.Regset} {sp : Block}
    {m : Mem} {ae : Aenv} {rm : Romem} {am : Amem} {bf : Builtins.BuiltinFunction}
    {al : List (BuiltinArg Reg)} {vl : List Val} {v : Val} {va : Aval}
    (EM : Ematch bc rs ae) (RM : Romatch bc m rm) (MM : Mmatch bc m am) (GM : GenvMatch bc ge)
    (SP : bc sp = .BCstack)
    (hargs : EvalBuiltinArgs ge.toSenv (fun r => rs.get r) (.Vptr sp Integers.Ptrofs.zero) m al vl)
    (hs : evalStaticBuiltinFunction o ae am rm bf al = some va)
    (hb : (Builtins.builtinFunctionSem bf).sem vl = some v) : Vmatch bc v va := by
  have VMA := abuiltin_args_sound o EM RM MM GM SP hargs
  unfold evalStaticBuiltinFunction at hs
  split at hs
  · rename_i v0 A
    have I := (Builtins.builtinFunctionSem bf).inject _ _ _
      (lessdefList_injectList (list_val_of_aval_sound VMA))
    rw [A, hb] at I
    have LD : Val.Lessdef v0 v := Val.lessdef_inject_id.mpr I
    cases LD with
    | refl => exact aval_of_val_sound hs
    | undef => simp [avalOfVal] at hs
  · cases hs

end

/-! ## Constructing block classifications -/

section NOSTACK
variable {bc : BlockClassification} (NOSTACK : BcNostack bc)
include NOSTACK

/-- `ValueAnalysis.pmatch_no_stack` -/
theorem pmatch_no_stack {b : Block} {ofs : Integers.Ptrofs} {p : Aptr} (h : Pmatch bc b ofs p) :
    Pmatch bc b ofs .Nonstack := by
  cases h <;> first
    | exact .nonstack (NOSTACK b) (by simp_all)
    | exact absurd ‹bc b = .BCstack› (NOSTACK b)
    | exact .nonstack (NOSTACK b) ‹_›

/-- `ValueAnalysis.vmatch_no_stack` -/
theorem vmatch_no_stack {v : Val} {x : Aval} (h : Vmatch bc v x) : Vmatch bc v (.Ifptr .Nonstack) := by
  cases h <;> first
    | exact .ifptr_p _ _ _ (pmatch_no_stack NOSTACK ‹_›)
    | constructor

/-- `ValueAnalysis.smatch_no_stack` -/
theorem smatch_no_stack {m : Mem} {b : Block} {p : Aptr} (h : Smatch bc m b p) :
    Smatch bc m b .Nonstack :=
  ⟨fun chunk ofs v hl => vmatch_no_stack NOSTACK (h.1 chunk ofs v hl),
   fun ofs b' ofs' q i hl => pmatch_no_stack NOSTACK (h.2 ofs b' ofs' q i hl)⟩

/-- `ValueAnalysis.mmatch_no_stack` -/
theorem mmatch_no_stack {m : Mem} {am : Amem} (astk : Ablock) (h : Mmatch bc m am) :
    Mmatch bc m (⟨astk, PTree.empty, .Nonstack, .Nonstack⟩ : Amem) := by
  refine ⟨fun b hb => absurd hb (NOSTACK b), fun id ab b _ hg => ?_,
    fun b h1 h2 => smatch_no_stack NOSTACK (h.mmatch_nonstack b h1 h2),
    fun b hb => smatch_no_stack NOSTACK (h.mmatch_top b hb), h.mmatch_below⟩
  simp at hg

end NOSTACK

end ValueAnalysis
