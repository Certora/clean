/-
  Abstract register environments and the dataflow lattice of the value
  analysis — port of the `AE` / `ematch` / `VA` part of
  `backend/ValueDomain.v`.

  Ported: `AE.gsspec` (`LPMap.gsspec`), the order `AE.ge` with
  `AE.ge_refl`, `AE.ge_trans`, `AE.ge_bot`, `AE.ge_lub_left`,
  `AE.ge_lub_right`, `AE.beq_correct`; `ematch_ge`, `ematch_update`,
  `ematch_init`, `eforget_ge`, `ematch_forget`, `ematch_incr`; the order
  `VA.ge` with `VA.ge_lub_left`, `VA.ge_lub_right`, `VA.beq_correct`.

  Difference from Rocq: the lattices `AE.lat` and `VA.lat` used by the
  dataflow solver carry the *free* order generated by `beq`, `bot` and
  `lub` (see `lib/LatticeFree.lean`).  `AE.ge_of_free` and `VA.ge_of_free`
  show that this order is included in CompCert's semantic orders `AE.ge`
  and `VA.ge`, which is how the solver's results are used.
-/
import CCLib.backend.ValueDomainMmatch
import CCLib.backend.RTL
import CCLib.lib.LatticeFree

namespace CC
namespace ValueDomain

namespace AE

/-- `LPMap.gsspec` -/
theorem gsspec {x : Aenv} {v : Aval} (p q : Positive) (hx : x ≠ .Bot) (hv : v ≠ .Vbot) :
    get p (set q v x) = if p = q then v else get p x := by
  cases x with
  | Bot => exact absurd rfl hx
  | Top_except m =>
    simp only [set, if_neg hv]
    by_cases ht : v = Vtop
    · simp only [if_pos ht, get]
      by_cases hpq : p = q
      · subst hpq; rw [PTree.grs, if_pos rfl, ht]
      · rw [PTree.gro q p m (Ne.symm hpq), if_neg hpq]
    · simp only [if_neg ht, get]
      by_cases hpq : p = q
      · subst hpq; rw [PTree.gss, if_pos rfl]
      · rw [PTree.gso q p v m (Ne.symm hpq), if_neg hpq]

/-- `AE.ge`: the pointwise order on abstract environments. -/
def Ge (x y : Aenv) : Prop := ∀ p, Vge (get p x) (get p y)

theorem ge_refl (x : Aenv) : Ge x x := fun _ => vge_refl _

theorem ge_trans {x y z : Aenv} (h1 : Ge x y) (h2 : Ge y z) : Ge x z :=
  fun p => vge_trans (h1 p) (h2 p)

theorem ge_bot (x : Aenv) : Ge x bot := fun _ => .bot _

/-- `AE.beq_correct` -/
theorem beq_correct {x y : Aenv} (h : beq x y = true) : ∀ p, get p x = get p y := by
  intro p
  cases x <;> cases y <;> simp only [beq] at h <;> try cases h
  · rfl
  · rename_i m n
    simp only [get, ptreeBeq_eq m n h p]

theorem ge_lub_left (strict : Bool) (x y : Aenv) : Ge (lub strict x y) x := by
  intro p
  cases x with
  | Bot => exact .bot _
  | Top_except m =>
    cases y with
    | Bot => exact vge_refl _
    | Top_except n =>
      simp only [lub, get]
      rw [PTree.gcombine _ rfl]
      cases hm : PTree.get p m <;> cases hn : PTree.get p n <;> (try simp only [optLub])
      all_goals first
        | exact vge_top _
        | exact vge_refl _
        | (rename_i u v
           by_cases hz : vlub strict u v = Vtop
           · simp only [hz, if_true]; exact vge_top _
           · simp only [hz, if_false]; exact vge_lub_l _ _ _)

theorem ge_lub_right (strict : Bool) (x y : Aenv) : Ge (lub strict x y) y := by
  intro p
  cases y with
  | Bot => cases x <;> exact .bot _
  | Top_except n =>
    cases x with
    | Bot => exact vge_refl _
    | Top_except m =>
      simp only [lub, get]
      rw [PTree.gcombine _ rfl]
      cases hm : PTree.get p m <;> cases hn : PTree.get p n <;> (try simp only [optLub])
      all_goals first
        | exact vge_top _
        | exact vge_refl _
        | (rename_i u v
           by_cases hz : vlub strict u v = Vtop
           · simp only [hz, if_true]; exact vge_top _
           · simp only [hz, if_false]; exact vge_lub_r _ _ _)

/-- The free order of the solver's lattice `AE.lat` is included in `AE.ge`. -/
theorem ge_of_free {strict : Bool} {x y : Aenv} (h : (lat strict).ge x y) : Ge x y :=
  Semilattice.freeGe_le beq bot (lub strict) Ge ge_refl
    (fun hb => ⟨fun p => by rw [beq_correct hb p]; exact vge_refl _,
               fun p => by rw [beq_correct hb p]; exact vge_refl _⟩)
    ge_trans ge_bot (ge_lub_left strict) (ge_lub_right strict) h

end AE

section MATCHENV
variable {bc : BlockClassification}

/-- `ValueDomain.ematch_ge` -/
theorem ematch_ge {e : RTL.Regset} {ae1 ae2 : Aenv} (h : Ematch bc e ae1) (hge : AE.Ge ae2 ae1) :
    Ematch bc e ae2 :=
  fun r => vmatch_ge (hge r) (h r)

theorem ematch_not_bot {e : RTL.Regset} {ae : Aenv} (h : Ematch bc e ae) : ae ≠ .Bot := by
  intro he; subst he
  have := h Positive.xH
  generalize PMap.get _ e = v at this
  cases this

/-- `ValueDomain.ematch_update` -/
theorem ematch_update {e : RTL.Regset} {ae : Aenv} {v : Val} {av : Aval} (r : Reg)
    (h : Ematch bc e ae) (hv : Vmatch bc v av) : Ematch bc (e.set r v) (AE.set r av ae) := by
  intro r0
  have hav : av ≠ .Vbot := by intro e; subst e; cases hv
  rw [AE.gsspec r0 r (ematch_not_bot h) hav, PMap.gsspec]
  by_cases hr : r0 = r
  · rw [if_pos hr, if_pos hr]; exact hv
  · rw [if_neg hr, if_neg hr]; exact h r0

/-- `ValueDomain.ematch_init` -/
theorem ematch_init (abi : Conventions1.AbiKind) :
    ∀ (rl : List Reg) (vl : List Val) (tl : List XType), Val.HasArgtypeList vl tl →
    (∀ v, v ∈ vl → Vmatch bc v (.Ifptr .Nonstack)) →
    Ematch bc (RTL.initRegs vl rl) (einitRegs abi rl tl)
  | [], vl, tl, _, _ => by
    intro r
    have : RTL.initRegs vl [] = PMap.init .Vundef := by cases vl <;> rfl
    rw [this, PMap.gi]
    simp only [einitRegs, AE.top, AE.get, PTree.gempty]
    exact .ifptr_undef _
  | a :: rl, [], tl, T, _ => by
    cases tl with
    | cons _ _ => exact absurd T (by simp [Val.HasArgtypeList])
    | nil =>
      have REC := ematch_init abi rl [] [] trivial (fun _ h => by cases h)
      have e1 : RTL.initRegs [] rl = PMap.init .Vundef := by cases rl <;> rfl
      have e2 : RTL.initRegs [] (a :: rl) = PMap.init .Vundef := rfl
      intro r
      rw [e2]
      simp only [einitRegs]
      rw [AE.gsspec r a (ematch_not_bot REC) (by simp)]
      split
      · rw [PMap.gi]; exact .ifptr_undef _
      · rw [e1] at REC; exact REC r
  | a :: rl, v :: vl, tl, T, V => by
    cases tl with
    | nil => exact absurd T (by simp [Val.HasArgtypeList])
    | cons t tl =>
      obtain ⟨T1, T2⟩ := T
      have REC := ematch_init abi rl vl tl T2 (fun v' h => V v' (List.mem_cons_of_mem _ h))
      intro r
      simp only [einitRegs, RTL.initRegs]
      have hne : (if Conventions1.parameterNeedsNormalization abi t = true then Aval.Ifptr .Nonstack
          else ofXtype t .Nonstack) ≠ .Vbot := by
        split
        · simp
        · cases t <;> simp [ofXtype]
      rw [AE.gsspec r a (ematch_not_bot REC) hne, PMap.gsspec]
      by_cases hr : r = a
      · rw [if_pos hr, if_pos hr]
        split
        · exact V v (List.mem_cons_self ..)
        · exact of_xtype_arg_sound t _ T1 (V v (List.mem_cons_self ..))
      · rw [if_neg hr, if_neg hr]; exact REC r

/-- `ValueDomain.eforget_ge` -/
theorem eforget_ge : ∀ (rl : List Reg) (ae : Aenv), AE.Ge (eforget rl ae) ae
  | [], ae => AE.ge_refl ae
  | r :: rl, ae => by
    refine AE.ge_trans (eforget_ge rl _) ?_
    intro p
    cases ae with
    | Bot => exact .bot _
    | Top_except m =>
      rw [AE.gsspec p r (by simp) (by simp [Vtop])]
      split
      · exact vge_top _
      · exact vge_refl _

/-- `ValueDomain.ematch_forget` -/
theorem ematch_forget {e : RTL.Regset} (rl : List Reg) {ae : Aenv} (h : Ematch bc e ae) :
    Ematch bc e (eforget rl ae) :=
  ematch_ge h (eforget_ge rl ae)

end MATCHENV

/-- `ValueDomain.ematch_incr` -/
theorem ematch_incr {bc bc' : BlockClassification} {e : RTL.Regset} {ae : Aenv}
    (h : Ematch bc e ae) (hincr : bcIncr bc bc') : Ematch bc' e ae :=
  fun r => vmatch_incr hincr (h r)

/-! ## The dataflow lattice `VA` -/

namespace VA

/-- `VA.ge` -/
def Ge : VAState → VAState → Prop
  | _, .Bot => True
  | .Bot, _ => False
  | .State ae1 am1, .State ae2 am2 =>
      AE.Ge ae1 ae2 ∧ ∀ bc m, Mmatch bc m am2 → Mmatch bc m am1

theorem ge_refl (x : VAState) : Ge x x := by
  cases x
  · trivial
  · exact ⟨AE.ge_refl _, fun _ _ h => h⟩

theorem ge_trans {x y z : VAState} (h1 : Ge x y) (h2 : Ge y z) : Ge x z := by
  match x, y, z, h1, h2 with
  | _, _, .Bot, _, _ => trivial
  | _, .Bot, .State _ _, _, h2 => exact h2.elim
  | .Bot, .State _ _, .State _ _, h1, _ => exact h1.elim
  | .State _ _, .State _ _, .State _ _, h1, h2 =>
    exact ⟨AE.ge_trans h1.1 h2.1, fun bc m h => h1.2 bc m (h2.2 bc m h)⟩

theorem ge_bot (x : VAState) : Ge x bot := by cases x <;> trivial

/-- `VA.beq_correct` -/
theorem beq_correct {x y : VAState} (h : beq x y = true) : Ge x y ∧ Ge y x := by
  match x, y, h with
  | .Bot, .Bot, _ => exact ⟨trivial, trivial⟩
  | .State _ _, .State _ _, h =>
    simp only [beq, Bool.and_eq_true] at h
    obtain ⟨h1, h2⟩ := h
    have E := AE.beq_correct h1
    exact ⟨⟨fun p => by rw [E p]; exact vge_refl _, fun bc m H => (mbeq_sound h2 m).2 H⟩,
           ⟨fun p => by rw [E p]; exact vge_refl _, fun bc m H => (mbeq_sound h2 m).1 H⟩⟩

/-- `VA.ge_lub_left` -/
theorem ge_lub_left (strict : Bool) (x y : VAState) : Ge (lub strict x y) x := by
  cases x with
  | Bot => exact ge_bot _
  | State ae1 am1 =>
    cases y with
    | Bot => exact ge_refl _
    | State ae2 am2 =>
      exact ⟨AE.ge_lub_left strict _ _, fun bc m h => mmatch_lub_l strict _ h⟩

/-- `VA.ge_lub_right` -/
theorem ge_lub_right (strict : Bool) (x y : VAState) : Ge (lub strict x y) y := by
  cases y with
  | Bot => cases x <;> exact ge_bot _
  | State ae2 am2 =>
    cases x with
    | Bot => exact ge_refl _
    | State ae1 am1 =>
      exact ⟨AE.ge_lub_right strict _ _, fun bc m h => mmatch_lub_r strict _ h⟩

/-- The free order of the solver's lattice `VA.lat` is included in `VA.ge`. -/
theorem ge_of_free {strict : Bool} {x y : VAState} (h : (lat strict).ge x y) : Ge x y :=
  Semilattice.freeGe_le beq bot (lub strict) Ge ge_refl beq_correct ge_trans ge_bot
    (ge_lub_left strict) (ge_lub_right strict) h

end VA

end ValueDomain
end CC
