/-
  Port of `backend/Asmexpandaux.ml`: utility functions used by the
  per-target `Asmexpand` (expansion of built-ins and pseudo-instructions
  after the verified compiler) and branch relaxation.  Like the OCaml code,
  it is not verified.

  Differences from OCaml:
  * The OCaml module is compiled against the `Asm` of the configured target.
    Here it is generic in the instruction type `I`; the few things it needs
    to know about instructions (labels, annotations, debug annotations, how
    to build a built-in) are the class `AsmInstr`, which each target's
    `Asmexpand` instantiates.
  * The global references (`current_code`, `current_function`,
    `next_label`) are the fields of `State`, threaded by the monad `M`
    (a state monad over `Except String`, whose errors stand for OCaml's
    `Error`, `assert false` and `invalid_arg`).  `State` also holds
    `current_function_stacksize`, a global reference of the targets'
    `Asmexpand.ml`.  The current function is represented by its signature
    and code.
  * `get_current_function` returns the code that was emitted (the caller
    rebuilds the function record).
  * The functor `Branch_relaxation` is the namespace `BranchRelaxation`,
    parameterized by a record `BranchInformation`.  The relaxation loop is
    unbounded in OCaml; here it is bounded by the length of the code plus
    one iterations (each iteration rewrites at least one branch), and an
    error is reported when the bound is reached.
  * `expand` is `expand_simple`: debugging information (`-g`) is not
    generated by the port (see `CCLib.debug.DebugInit`), so the
    `expand_debug` path, which records live ranges and scopes through the
    `Debug` hooks, is not used.  Its pure part, `translate_annot`, is
    ported.
-/
import CCLib.common.ASTTheory

namespace CC
namespace Asmexpandaux

/-- What `Asmexpandaux` needs to know about the instructions of a target. -/
class AsmInstr (I : Type) where
  /-- `Plabel lbl ↦ some lbl` -/
  labelOf : I → Option Positive
  /-- `Plabel` -/
  mkLabel : Positive → I
  /-- `Pbuiltin (EF_annot kind _ _) _ _ ↦ some kind` -/
  annotKind : I → Option Positive
  /-- `Pbuiltin (EF_debug _ _ _) _ _` -/
  isDebug : I → Bool
  /-- `Pbuiltin ef [] BR_none` -/
  mkBuiltin : ExtFun → I

/-- The global state of the expansion. -/
structure State (I : Type) where
  /-- `current_code`, in reverse order -/
  code : List I := []
  /-- signature of `current_function` -/
  sig : Signature := signature_main
  /-- code of `current_function` -/
  fnCode : List I := []
  /-- `next_label` -/
  nextLabel : Option Positive := none
  /-- `current_function_stacksize` (of the targets' `Asmexpand`) -/
  stacksize : Z := 0

/-- The expansion monad. -/
abbrev M (I : Type) := StateT (State I) (Except String)

variable {I : Type}

/-- `raise (Error s)` -/
def error {α : Type} (s : String) : M I α := throw s

/-- Lift a computation that may fail. -/
def liftExcept {α : Type} : Except String α → M I α
  | .ok a => pure a
  | .error s => throw s

/-! ## Buffering the expanded code -/

/-- `emit` -/
def emit (i : I) : M I Unit := modify fun s => { s with code := i :: s.code }

/-! ## Generation of fresh labels -/

/-- One step of the computation of `firstUnusedLabel`. -/
def labelStep [AsmInstr I] (next : Positive) (i : I) : Positive :=
  match AsmInstr.labelOf i with
  | some l => if l < next then next else l.succ
  | none => next

/-- The first label after every label of `code` (the on-demand
    computation of `new_label`). -/
def firstUnusedLabel [AsmInstr I] (code : List I) : Positive :=
  code.foldl labelStep .xH

/-- `new_label` -/
def newLabel [AsmInstr I] : M I Positive := do
  let s ← get
  let lbl := match s.nextLabel with
    | some l => l
    | none => firstUnusedLabel s.fnCode
  set { s with nextLabel := some lbl.succ }
  return lbl

/-- `set_current_function` -/
def setCurrentFunction (sig : Signature) (code : List I) : M I Unit :=
  modify fun s => { s with sig := sig, fnCode := code, nextLabel := none, code := [] }

/-- `get_current_function_args` -/
def getCurrentFunctionArgs : M I (List ATyp) := do
  return (← get).sig.projArgs

/-- `is_current_function_variadic` -/
def isCurrentFunctionVariadic : M I Bool := do
  return (← get).sig.sig_cc.cc_vararg.isSome

/-- `get_current_function_sig` -/
def getCurrentFunctionSig : M I Signature := do
  return (← get).sig

/-- `get_current_function`: the emitted code; the current function is
    reset to `dummy_function`. -/
def getCurrentFunction : M I (List I) := do
  let c := (← get).code.reverse
  setCurrentFunction signature_main []
  return c

/-! ## Expansion -/

/-- `translate_annot`: the location of a variable described by the first
    argument of a debug annotation (`-g` only). -/
def translateAnnot {A P D : Type} (sp : A) (pregToDwarf : P → D) :
    List (BuiltinArg P) → Option (A × BuiltinArg D)
  | [] => none
  | a :: _ =>
    let rec aux : BuiltinArg P → Option (A × BuiltinArg D)
      | .BA x => some (sp, .BA (pregToDwarf x))
      | .BA_addrstack ofs => some (sp, .BA_addrstack ofs)
      | .BA_splitlong hi lo =>
        match aux hi, aux lo with
        | some (_, hi), some (_, lo) => some (sp, .BA_splitlong hi lo)
        | _, _ => none
      | _ => none
    aux a

/-- `builtin_nop` -/
def builtinNop [AsmInstr I] : I :=
  AsmInstr.mkBuiltin
    (.EF_builtin "__builtin_nop" { sig_args := [], sig_res := .Xvoid, sig_cc := cc_default })

/-- `lbl_follows`: is the next non-debug instruction a label? -/
def lblFollows [AsmInstr I] : List I → Bool
  | [] => false
  | i :: rest => if AsmInstr.isDebug i then lblFollows rest else (AsmInstr.labelOf i).isSome

/-- `expand_simple` (and `expand` without `-g`): expand each instruction
    with `simple`; an annotation of kind 2 followed by a label is followed
    by a `nop`, so that the two do not share an address. -/
def expand [AsmInstr I] (simple : I → M I Unit) : List I → M I Unit
  | [] => pure ()
  | i :: rest => do
    simple i
    match AsmInstr.annotKind i with
    | some kind => if kind.toNat = 2 && lblFollows rest then simple builtinNop
    | none => pure ()
    expand simple rest

/-! ## Branch relaxation -/

/-- `BRANCH_INFORMATION` -/
structure BranchInformation (I : Type) where
  /-- `instr_size` (in bytes) -/
  instrSize : I → Nat
  /-- `need_relaxation ~map pc instr` -/
  needRelaxation : (Positive → Except String Int) → Int → I → Except String Bool
  /-- `relax_instruction` -/
  relaxInstruction : I → M I (List I)

namespace BranchRelaxation

variable [AsmInstr I] (B : BranchInformation I)

/-- `set_label_positions`: fill the table label ↦ position in code. -/
def setLabelPositions (tbl : PTree Int) (pc : Int) : List I → PTree Int
  | [] => tbl
  | i :: code =>
    match AsmInstr.labelOf i with
    | some lbl => setLabelPositions (tbl.set lbl pc) pc code
    | none => setLabelPositions tbl (pc + B.instrSize i) code

/-- `get_label_position` -/
def getLabelPosition (tbl : PTree Int) (lbl : Positive) : Except String Int :=
  match tbl.get lbl with
  | some pc => .ok pc
  | none => .error s!"Fatal error: unknown label {lbl.toNat}"

/-- `need_relaxation` -/
def needRelaxation (tbl : PTree Int) (pc : Int) : List I → Except String Bool
  | [] => .ok false
  | i :: code => do
    if ← B.needRelaxation (getLabelPosition tbl) pc i then return true
    needRelaxation tbl (pc + B.instrSize i) code

/-- `do_relaxation` -/
def doRelaxation (tbl : PTree Int) (accu : List I) (pc : Int) : List I → M I (List I)
  | [] => return accu.reverse
  | i :: code => do
    let accu ←
      if ← liftExcept (B.needRelaxation (getLabelPosition tbl) pc i) then
        pure ((← B.relaxInstruction i).reverse ++ accu)
      else pure (i :: accu)
    doRelaxation tbl accu (pc + B.instrSize i) code

/-- The loop `relax` of `relaxation`, with at most `fuel` iterations. -/
def relax : Nat → List I → M I (List I)
  | 0, _ => error "branch relaxation does not converge"
  | fuel + 1, code => do
    let tbl := setLabelPositions B PTree.empty 0 code
    if !(← liftExcept (needRelaxation B tbl 0 code)) then return code
    relax fuel (← doRelaxation B tbl [] 0 code)

/-- `relaxation`: relax the conditional branches of `code` whose target is
    out of range, until none is. -/
def relaxation (code : List I) : M I (List I) := do
  let sig := (← get).sig
  setCurrentFunction sig code
  let res ← relax B (code.length + 1) code
  setCurrentFunction signature_main []
  return res

/-- When no branch needs relaxation, the code is unchanged. -/
theorem relax_no_relaxation (fuel : Nat) (code : List I) (s : State I)
    (h : needRelaxation B (setLabelPositions B PTree.empty 0 code) 0 code = .ok false) :
    (relax B (fuel + 1) code).run s = .ok (code, s) := by
  simp [relax, h, liftExcept]
  rfl

end BranchRelaxation

/-! ## Basic properties -/

theorem labelStep_le [AsmInstr I] (next : Positive) (i : I) :
    next ≤ labelStep next i := by
  unfold labelStep
  split
  · split
    · exact Nat.le_refl _
    · next l _ h =>
      show next.toNat ≤ (Positive.succ l).toNat
      rw [Positive.toNat_succ]; rw [Positive.lt_iff] at h; omega
  · exact Nat.le_refl _

theorem le_foldl_labelStep [AsmInstr I] (code : List I) (start : Positive) :
    start ≤ code.foldl labelStep start := by
  induction code generalizing start with
  | nil => exact Nat.le_refl _
  | cons j rest ih => exact Nat.le_trans (labelStep_le start j) (ih _)

theorem lt_foldl_labelStep [AsmInstr I] (code : List I) (start : Positive) (i : I)
    (hi : i ∈ code) (l : Positive) (hl : AsmInstr.labelOf i = some l) :
    l < code.foldl labelStep start := by
  induction code generalizing start with
  | nil => cases hi
  | cons j rest ih =>
    rcases List.mem_cons.mp hi with rfl | hi
    · refine Nat.lt_of_lt_of_le ?_ (le_foldl_labelStep rest _)
      show l.toNat < (labelStep start i).toNat
      unfold labelStep
      rw [hl]
      simp only
      split
      · next h => exact h
      · simp
    · exact ih _ hi

/-- A fresh label is greater than every label of the current function. -/
theorem lt_firstUnusedLabel [AsmInstr I] (code : List I) (i : I) (hi : i ∈ code)
    (l : Positive) (hl : AsmInstr.labelOf i = some l) :
    l < firstUnusedLabel code :=
  lt_foldl_labelStep code _ i hi l hl

/-- `lbl_follows` holds on code that starts with a label. -/
theorem lblFollows_label [AsmInstr I] (i : I) (rest : List I) (l : Positive)
    (hd : AsmInstr.isDebug i = false) (hl : AsmInstr.labelOf i = some l) :
    lblFollows (i :: rest) = true := by
  simp [lblFollows, hd, hl]

end Asmexpandaux
end CC
