/-
  Theorems of `lib/Integers.v` about bit-field extraction and insertion
  with a clipped width: `Int.shl_zero_ext_min`, `Int.shl_sign_ext_min`,
  `Int.zero_ext_shru_min`, `Int.sign_ext_shr_min` (and their `Int64`
  counterparts).  They justify the `ubfiz`/`sbfiz`/`ubfx`/`sbfx` instructions
  generated by `aarch64/Asmgen.v`, which clip the field width to the word size.

  Generic in the word size `w` (namespace `CC.Integers.MI`); shift amounts are
  read as `Nat`s with `BitVec.toNat`.
-/
import CCLib.lib.IntegersShifts

namespace CC
namespace Integers
namespace MI

variable {w : Nat}

/-- `Int.shl_zero_ext_min` -/
theorem shl_zero_ext_min (x y : BitVec w) (n : Nat) :
    shl (zero_ext n x) y = shl (zero_ext (min n (w - y.toNat)) x) y := by
  apply same_bits_eq; intro i hi
  rw [bits_shl _ _ hi, bits_shl _ _ hi]
  split
  · rfl
  · rw [bits_zero_ext, bits_zero_ext]
    by_cases h : i - y.toNat < n
    · rw [decide_eq_true h, decide_eq_true (by omega)]
    · rw [decide_eq_false h, decide_eq_false (by omega)]

/-- `Int.shl_sign_ext_min` -/
theorem shl_sign_ext_min (x y : BitVec w) (n : Nat) (hy : y.toNat < w) :
    shl (sign_ext n x) y = shl (sign_ext (min n (w - y.toNat)) x) y := by
  by_cases hn : n = 0
  · subst hn; simp
  apply same_bits_eq; intro i hi
  rw [bits_shl _ _ hi, bits_shl _ _ hi]
  split
  · rfl
  · rw [bits_sign_ext (by omega) _ (by omega), bits_sign_ext (by omega) _ (by omega)]
    congr 1
    by_cases h1 : i - y.toNat < n
    · rw [if_pos h1, if_pos (by omega)]
    · rw [if_neg h1]
      by_cases h2 : i - y.toNat < min n (w - y.toNat)
      · omega
      · rw [if_neg h2]; omega

/-- `Int.zero_ext_shru_min` -/
theorem zero_ext_shru_min (x y : BitVec w) (n : Nat) :
    zero_ext n (shru x y) = zero_ext (min n (w - y.toNat)) (shru x y) := by
  apply same_bits_eq; intro i hi
  rw [bits_zero_ext, bits_zero_ext, bits_shru _ _ hi]
  by_cases h : i + y.toNat < w
  · rw [if_pos h]
    by_cases h1 : i < n
    · rw [decide_eq_true h1, decide_eq_true (by omega)]
    · rw [decide_eq_false h1, decide_eq_false (by omega)]
  · rw [if_neg h]; simp

/-- `Int.sign_ext_shr_min` -/
theorem sign_ext_shr_min (x y : BitVec w) (n : Nat) (hy : y.toNat < w) :
    sign_ext n (shr x y) = sign_ext (min n (w - y.toNat)) (shr x y) := by
  by_cases hn : n = 0
  · subst hn; simp
  apply same_bits_eq; intro i hi
  rw [bits_sign_ext (by omega) _ hi, bits_sign_ext (by omega) _ hi]
  by_cases h1 : i < min n (w - y.toNat)
  · rw [if_pos (by omega), if_pos h1]
  · rw [if_neg h1]
    have hm : min n (w - y.toNat) - 1 < w := by omega
    by_cases h2 : i < n
    · rw [if_pos h2, bits_shr _ _ hi, bits_shr _ _ hm]
      congr 1
      split <;> split <;> omega
    · rw [if_neg h2, bits_shr _ _ (by omega), bits_shr _ _ hm]
      congr 1
      split <;> split <;> omega

end MI
end Integers
end CC
