/-
  A generic way to equip a type with a `Semilattice` structure from its
  executable operations alone (`beq`, `bot`, `lub`).

  CompCert's lattices used by the value analysis (`AVal`, `AE`, `VA` in
  `ValueDomain.v`) come with an order (`vge`, pointwise `AE.ge`, and the
  semantic memory inclusion of `VA.ge`) whose lattice laws need long
  proofs (`vge_lub_l`, `mmatch_lub_l`, …) that are not ported yet.  The
  dataflow solver of `Kildall.lean` only *computes* with `beq`, `bot` and
  `lub`; its correctness theorems are stated with the `eq`/`ge` of the
  `Semilattice` instance.  `Semilattice.free` takes for `eq` the
  equivalence generated by `beq` and for `ge` the preorder generated by
  `eq`, `bot ≤ x`, `x ≤ lub x y` and `y ≤ lub x y`: the weakest relations
  satisfying the `Semilattice` laws.  Every pair related by them is
  related by any order for which `lub` is an upper bound and `bot` is a
  least element, so solver results stated with `free` transfer to
  CompCert's orders once those laws are proved.
-/
import CCLib.lib.Lattice

namespace CC
namespace Semilattice

section
variable {t : Type} (beq : t → t → Bool) (bot : t) (lub : t → t → t)

/-- The equivalence relation generated by `beq x y = true`. -/
inductive FreeEq : t → t → Prop where
  | base {x y} : beq x y = true → FreeEq x y
  | refl (x) : FreeEq x x
  | symm {x y} : FreeEq x y → FreeEq y x
  | trans {x y z} : FreeEq x y → FreeEq y z → FreeEq x z

/-- The preorder generated by `FreeEq`, `bot` being least and `lub`
    being an upper bound. -/
inductive FreeGe : t → t → Prop where
  | ofEq {x y} : FreeEq beq x y → FreeGe x y
  | bot (x) : FreeGe x bot
  | lub_left (x y) : FreeGe (lub x y) x
  | lub_right (x y) : FreeGe (lub x y) y
  | trans {x y z} : FreeGe x y → FreeGe y z → FreeGe x z

/-- The `Semilattice` structure generated by `beq`, `bot` and `lub`. -/
@[reducible] def free : Semilattice t where
  eq := FreeEq beq
  eq_refl := .refl
  eq_sym := .symm
  eq_trans := .trans
  beq := beq
  beq_correct := .base
  ge := FreeGe beq bot lub
  ge_refl := .ofEq
  ge_trans := .trans
  bot := bot
  ge_bot := .bot
  lub := lub
  ge_lub_left := .lub_left
  ge_lub_right := .lub_right

/-- Anything related by the free order is related by any preorder `R`
    containing `beq`, with `bot` least and `lub` an upper bound. -/
theorem freeGe_le (R : t → t → Prop) (hrefl : ∀ x, R x x)
    (hsymm : ∀ {x y}, beq x y = true → R x y ∧ R y x)
    (htrans : ∀ {x y z}, R x y → R y z → R x z)
    (hbot : ∀ x, R x bot) (hl : ∀ x y, R (lub x y) x) (hr : ∀ x y, R (lub x y) y)
    {x y : t} (h : FreeGe beq bot lub x y) : R x y := by
  have heq : ∀ {x y}, FreeEq beq x y → R x y ∧ R y x := by
    intro x y h
    induction h with
    | base hb => exact hsymm hb
    | refl x => exact ⟨hrefl x, hrefl x⟩
    | symm _ ih => exact ⟨ih.2, ih.1⟩
    | trans _ _ ih1 ih2 => exact ⟨htrans ih1.1 ih2.1, htrans ih2.2 ih1.2⟩
  induction h with
  | ofEq h => exact (heq h).1
  | bot x => exact hbot x
  | lub_left x y => exact hl x y
  | lub_right x y => exact hr x y
  | trans _ _ ih1 ih2 => exact htrans ih1 ih2

end

end Semilattice
end CC
