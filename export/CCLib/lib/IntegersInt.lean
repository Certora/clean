theorem rol_zero (x : Int) :
    rol x zero = x :=
  MI.rol_zero x

theorem ror_zero (x : Int) :
    ror x zero = x :=
  MI.ror_zero x

theorem bits_zero_ext (n : Nat) (x : Int) (i : Nat) :
    testbit (zero_ext n x) i = (decide (i < n) && testbit x i) :=
  MI.bits_zero_ext n x i

theorem zero_ext_above {n : Nat} (h : 32 ≤ n) (x : Int) :
    zero_ext n x = x :=
  MI.zero_ext_above h x

theorem zero_ext_idem (n : Nat) (x : Int) :
    zero_ext n (zero_ext n x) = zero_ext n x :=
  MI.zero_ext_idem n x

theorem zero_ext_widen {n n' : Nat} (h : n ≤ n') (x : Int) :
    zero_ext n' (zero_ext n x) = zero_ext n x :=
  MI.zero_ext_widen h x

theorem zero_ext_narrow {n n' : Nat} (h : n ≤ n') (x : Int) :
    zero_ext n (zero_ext n' x) = zero_ext n x :=
  MI.zero_ext_narrow h x

theorem zero_ext_mod (n : Nat) (x : Int) :
    unsigned (zero_ext n x) = unsigned x % (2 : Z) ^ n :=
  MI.zero_ext_mod n x

theorem zero_ext_range (n : Nat) (x : Int) :
    unsigned (zero_ext n x) < (2 : Z) ^ n :=
  MI.zero_ext_range n x

theorem bits_sign_ext {n : Nat} (hn : 0 < n) (x : Int) {i : Nat} (hi : i < 32) :
    testbit (sign_ext n x) i = testbit x (if i < n then i else n - 1) :=
  MI.bits_sign_ext hn x hi

theorem sign_ext_above {n : Nat} (hn : 0 < n) (h : 32 ≤ n) (x : Int) :
    sign_ext n x = x :=
  MI.sign_ext_above hn h x

theorem sign_ext_widen {n n' : Nat} (hn : 0 < n) (h : n ≤ n') (x : Int) :
    sign_ext n' (sign_ext n x) = sign_ext n x :=
  MI.sign_ext_widen hn h x

theorem sign_ext_idem {n : Nat} (hn : 0 < n) (x : Int) :
    sign_ext n (sign_ext n x) = sign_ext n x :=
  MI.sign_ext_idem hn x

theorem sign_ext_narrow {n n' : Nat} (hn : 0 < n) (h : n ≤ n') (x : Int) :
    sign_ext n (sign_ext n' x) = sign_ext n x :=
  MI.sign_ext_narrow hn h x

theorem zero_ext_sign_ext {n n' : Nat} (hn : 0 < n) (h : n ≤ n') (x : Int) :
    zero_ext n (sign_ext n' x) = zero_ext n x :=
  MI.zero_ext_sign_ext hn h x

theorem sign_ext_zero_ext {n n' : Nat} (hn : 0 < n) (h : n ≤ n') (x : Int) :
    sign_ext n (zero_ext n' x) = sign_ext n x :=
  MI.sign_ext_zero_ext hn h x

end Int
end Integers
end CC
