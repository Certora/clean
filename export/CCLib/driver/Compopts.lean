/-
  Port of `driver/Compopts.v`: the command-line options that influence the
  code generated by the verified part of CompCert.

  In Rocq these are `Parameter`s `unit -> bool`, mapped by extraction to the
  flags of `Clflags.ml`.  Here they are the fields of a record, which the
  per-target compiler configurations (`Compiler.Config` of the AArch64,
  x86-64 and RISC-V back ends) extend; `Driver.compilerConfig` fills them in
  from the parsed command line.  The defaults are those of `Clflags.ml`.
-/

namespace CC

/-- The options of `Compopts.v`. -/
structure Compopts where
  /-- `Compopts.optim_for_size`: optimize for code size rather than speed. -/
  optimForSize : Bool := false
  /-- `Compopts.propagate_float_constants`: value analysis tracks FP constants. -/
  propagateFloatConstants : Bool := true
  /-- `Compopts.generate_float_constants`: FP constants may be materialized
      as immediates. -/
  generateFloatConstants : Bool := true
  /-- `Compopts.va_strict`: value analysis assumes pointers are not forged
      from integers. -/
  vaStrict : Bool := false
  /-- `Compopts.optim_tailcalls`: turn calls in tail position into tail calls. -/
  optimTailcalls : Bool := true
  /-- `Compopts.optim_constprop`: constant propagation. -/
  optimConstprop : Bool := true
  /-- `Compopts.optim_CSE`: common subexpression elimination. -/
  optimCSE : Bool := true
  /-- `Compopts.optim_redundancy`: redundancy (dead code) elimination. -/
  optimRedundancy : Bool := true
  /-- `Compopts.thumb`: generate Thumb-2 code (ARM only). -/
  thumb : Bool := false
  /-- `Compopts.debug`: keep debugging information. -/
  debug : Bool := false
  deriving Repr, DecidableEq

end CC
