/-
  Correctness proof for x86-64 code generation, part 3 — the cases of
  `step_simulation` (`x86/Asmgenproof.v`) for the Mach instructions that
  translate to straight-line code: `Mlabel`, `Mgetstack`, `Msetstack`,
  `Mgetparam`, `Mop`, `Mload`, `Mstore` and `Mcond` (both outcomes).

  Each case is a separate theorem; `step_simulation` in
  `x86/Asmgenproof.lean` dispatches to them.  The case analysis on the
  shape of the conditional jump (`Pjcc`, `Pjcc; Pjcc`, `Pjcc2`) done
  inline in Rocq is factored out as `mk_jcc_true` / `mk_jcc_false`.
-/
import CCLib.x86.AsmgenproofBasic
import CCLib.x86.OpInject

namespace CC
namespace X86
namespace Asmgenproof

open Asm Asmgen Asmgenproof0 Asmgenproof1 Smallstep Conventions1

/-! ## Conditional jumps -/

section JCC
variable {ge : Asm.CGenv} {fn : Asm.Function}

theorem exec_Pjcc (c : Testcond) (lbl : Label) (rs : Regset) (m : Mem) :
    execInstr ge fn (.Pjcc c lbl) rs m =
      match evalTestcond c rs with
      | some true => gotoLabel fn lbl rs m
      | some false => .Next (nextinstr rs) m
      | none => .Stuck := rfl

theorem exec_Pjcc2 (c1 c2 : Testcond) (lbl : Label) (rs : Regset) (m : Mem) :
    execInstr ge fn (.Pjcc2 c1 c2 lbl) rs m =
      match evalTestcond c1 rs, evalTestcond c2 rs with
      | some true, some true => gotoLabel fn lbl rs m
      | some _, some _ => .Next (nextinstr rs) m
      | _, _ => .Stuck := rfl

/-- The conditional jump generated by `mk_jcc`, when the condition holds. -/
theorem mk_jcc_true (xc : Extcond) (lbl : Label) (k : Code) (rs : Regset) (m : Mem)
    (h : evalExtcond xc rs = some true) :
    ∃ jmp k' rs2, ExecStraightOpt ge fn (mkJcc xc lbl k) rs m (jmp :: k') rs2 m ∧
      (∀ r, dataPreg r = true → rs2 r = rs r) ∧
      execInstr ge fn jmp rs2 m = gotoLabel fn lbl rs2 m := by
  cases xc with
  | Cond_base c =>
    exact ⟨_, _, rs, .refl _ _ _, fun _ _ => rfl, by
      rw [exec_Pjcc]; simp only [evalExtcond] at h; rw [h]⟩
  | Cond_and c1 c2 =>
    simp only [evalExtcond] at h
    revert h
    cases h1 : evalTestcond c1 rs <;> cases h2 : evalTestcond c2 rs <;> intro h <;>
      simp only [reduceCtorEq, Option.some.injEq, Bool.and_eq_true] at h
    obtain ⟨rfl, rfl⟩ := h
    exact ⟨_, _, rs, .refl _ _ _, fun _ _ => rfl, by rw [exec_Pjcc2, h1, h2]⟩
  | Cond_or c1 c2 =>
    simp only [evalExtcond] at h
    revert h
    cases h1 : evalTestcond c1 rs with
    | none => cases evalTestcond c2 rs <;> intro h <;> cases h
    | some b1 =>
      cases h2 : evalTestcond c2 rs with
      | none => intro h; cases h
      | some b2 =>
        intro h
        cases b1 with
        | true =>
          exact ⟨_, _, rs, .refl _ _ _, fun _ _ => rfl, by rw [exec_Pjcc, h1]⟩
        | false =>
          simp only [Option.some.injEq, Bool.false_or] at h; subst h
          refine ⟨_, _, nextinstr rs,
            .intro _ _ _ _ _ _ (.one _ _ _ _ _ _ (by rw [exec_Pjcc, h1]) (nextinstr_pc _)),
            fun r hr => nextinstr_inv1 _ hr, ?_⟩
          rw [exec_Pjcc, eval_testcond_nextinstr, h2]

/-- The conditional jump generated by `mk_jcc`, when the condition fails. -/
theorem mk_jcc_false (xc : Extcond) (lbl : Label) (k : Code) (rs : Regset) (m : Mem)
    (h : evalExtcond xc rs = some false) :
    ∃ rs2, ExecStraight ge fn (mkJcc xc lbl k) rs m k rs2 m ∧
      ∀ r, dataPreg r = true → rs2 r = rs r := by
  cases xc with
  | Cond_base c =>
    simp only [evalExtcond] at h
    exact ⟨_, .one _ _ _ _ _ _ (by rw [exec_Pjcc, h]) (nextinstr_pc _),
      fun r hr => nextinstr_inv1 _ hr⟩
  | Cond_and c1 c2 =>
    simp only [evalExtcond] at h
    revert h
    cases h1 : evalTestcond c1 rs <;> cases h2 : evalTestcond c2 rs <;> intro h <;>
      simp only [reduceCtorEq, Option.some.injEq] at h
    rename_i b1 b2
    refine ⟨_, .one _ _ _ _ _ _ ?_ (nextinstr_pc _), fun r hr => nextinstr_inv1 _ hr⟩
    rw [exec_Pjcc2, h1, h2]
    cases b1 <;> cases b2 <;> simp_all
  | Cond_or c1 c2 =>
    simp only [evalExtcond] at h
    revert h
    cases h1 : evalTestcond c1 rs <;> cases h2 : evalTestcond c2 rs <;> intro h <;>
      simp only [reduceCtorEq, Option.some.injEq, Bool.or_eq_false_iff] at h
    obtain ⟨rfl, rfl⟩ := h
    refine ⟨_, exec_straight_two (by rw [exec_Pjcc, h1]) ?_ (nextinstr_pc _) (nextinstr_pc _),
      fun r hr => by rw [nextinstr_inv1 _ hr, nextinstr_inv1 _ hr]⟩
    rw [exec_Pjcc, eval_testcond_nextinstr, h2]

end JCC

theorem pregNotin_RAX_destroyedBySetstack (ty : ATyp) :
    PregNotin (.IR .RAX) (destroyedBySetstack ty) := by
  intro mr hm
  cases ty <;> simp [destroyedBySetstack] at hm <;> subst hm <;> simp [pregOf]

section PRESERVATION
variable {prog : Mach.Program} {tprog : Asm.Program}
  (TRANSF : MatchProg prog tprog) (win64 : Bool)
include TRANSF

/-- `step_simulation`, case `Mlabel`. -/
theorem step_Mlabel {s fb sp lbl c ms m st}
    (MS : MatchStates prog.globalenv (.State s fb sp (.Mlabel lbl :: c) ms m) st) :
    ∃ st', Smallstep.Plus (Asm.Step win64 tprog.globalenv) st E0 st' ∧
      MatchStates prog.globalenv (.State s fb sp c ms m) st' := by
  cases MS with
  | intro _ _ _ _ ep _ _ m' rs f tf tc STACKS FIND MEXT AT AG _ =>
    refine exec_straight_steps TRANSF win64 STACKS MEXT FIND AT ?_
    intro k c TR
    simp only [translInstr] at TR
    cases TR
    exact ⟨nextinstr rs, .one _ _ _ _ _ _ rfl (nextinstr_pc _), agree_nextinstr AG,
      fun h => by cases h⟩

/-- `step_simulation`, case `Mgetstack`. -/
theorem step_Mgetstack {s fb sp ofs ty dst c ms m v st}
    (MS : MatchStates prog.globalenv (.State s fb sp (.Mgetstack ofs ty dst :: c) ms m) st)
    (H : Mach.loadStack m sp ty ofs = some v) :
    ∃ st', Smallstep.Plus (Asm.Step win64 tprog.globalenv) st E0 st' ∧
      MatchStates prog.globalenv (.State s fb sp c (Mach.Regset.set dst v ms) m) st' := by
  cases MS with
  | intro _ _ _ _ ep _ _ m' rs f tf tc STACKS FIND MEXT AT AG _ =>
    obtain ⟨v', A, B⟩ := Mem.loadv_extends MEXT H (.refl _)
    rw [sp_val AG] at A
    refine exec_straight_steps TRANSF win64 STACKS MEXT FIND AT ?_
    intro k c TR
    simp only [translInstr] at TR
    obtain ⟨rs', P, Q, R⟩ := loadind_correct (ge := tprog.globalenv) (fn := tf) .RSP ofs ty dst
      k rs c m' v' TR A
    exact ⟨rs', P, agree_set_mreg AG (by rw [Q]; exact B) R, fun h => by cases h⟩

/-- `step_simulation`, case `Msetstack`. -/
theorem step_Msetstack {s fb sp src ofs ty c ms m m2 st}
    (MS : MatchStates prog.globalenv (.State s fb sp (.Msetstack src ofs ty :: c) ms m) st)
    (H : Mach.storeStack m sp ty ofs (ms src) = some m2) :
    ∃ st', Smallstep.Plus (Asm.Step win64 tprog.globalenv) st E0 st' ∧
      MatchStates prog.globalenv
        (.State s fb sp c (Mach.undefRegs (destroyedBySetstack ty) ms) m2) st' := by
  cases MS with
  | intro _ _ _ _ ep _ _ m' rs f tf tc STACKS FIND MEXT AT AG AXP =>
    obtain ⟨m2', A, B⟩ := Mem.storev_extends MEXT H (.refl _) (preg_val AG src)
    rw [sp_val AG] at A
    refine exec_straight_steps TRANSF win64 STACKS B FIND AT ?_
    intro k c TR
    simp only [translInstr] at TR
    obtain ⟨rs2, P, Q⟩ := storeind_correct (ge := tprog.globalenv) (fn := tf) .RSP ofs ty src
      k rs c m' m2' TR A
    exact ⟨rs2, P, agree_undef_regs AG Q,
      fun h => by rw [Q _ rfl (pregNotin_RAX_destroyedBySetstack ty)]; exact AXP h⟩

/-- `step_simulation`, case `Mgetparam`. -/
theorem step_Mgetparam {s fb f0 sp ofs ty dst c ms m v st}
    (MS : MatchStates prog.globalenv (.State s fb sp (.Mgetparam ofs ty dst :: c) ms m) st)
    (H0 : Genv.findFunctPtr prog.globalenv fb = some (.Internal f0))
    (H1 : Mach.loadStack m sp Tptr f0.fn_link_ofs = some (Mach.parentSp s))
    (H2 : Mach.loadStack m (Mach.parentSp s) ty ofs = some v) :
    ∃ st', Smallstep.Plus (Asm.Step win64 tprog.globalenv) st E0 st' ∧
      MatchStates prog.globalenv
        (.State s fb sp c (Mach.Regset.set dst v (Mach.Regset.set tempForParentFrame .Vundef ms)) m)
        st' := by
  cases MS with
  | intro _ _ _ _ ep _ _ m' rs f tf tc STACKS FIND MEXT AT AG AXP =>
    rw [FIND] at H0; cases H0
    obtain ⟨parent', A, B⟩ := Mem.loadv_extends MEXT H1 (.refl _)
    rw [sp_val AG] at A
    have e := lessdef_parent_sp STACKS B
    subst e
    obtain ⟨v', C, D⟩ := Mem.loadv_extends MEXT H2 (.refl _)
    refine exec_straight_steps TRANSF win64 STACKS MEXT FIND AT ?_
    intro k c TR
    simp only [translInstr] at TR
    have AG1 : ∀ {rs1 : Regset}, (∀ r', dataPreg r' = true → r' ≠ .IR .RAX → rs1 r' = rs r') →
        Agree (Mach.Regset.set tempForParentFrame .Vundef ms) sp rs1 :=
      fun ho => agree_set_mreg AG (.undef _) ho
    have DIFF : it1IsParent ep (.Mgetparam ofs ty dst) = true → Preg.IR .RAX ≠ pregOf dst := by
      intro h he
      have hd : dst ≠ .AX := by simpa [it1IsParent] using h
      exact hd (preg_of_injective (r1 := .AX) he).symm
    cases ep with
    | true =>
      simp only [if_true] at TR
      obtain ⟨rs1, P, Q, R⟩ := loadind_correct (ge := tprog.globalenv) (fn := tf) .RAX ofs ty dst
        k rs c m' v' TR (by rw [AXP rfl]; exact C)
      refine ⟨rs1, P, agree_set_mreg (AG1 (fun _ _ _ => rfl)) (by rw [Q]; exact D) R, ?_⟩
      intro h
      rw [R (.IR .RAX) rfl (DIFF h)]
      exact AXP rfl
    | false =>
      simp only [Bool.false_eq_true, if_false, res_bind_OK] at TR
      obtain ⟨c1, EQ, EQ0⟩ := TR
      obtain ⟨rs1, P, Q, R⟩ := loadind_correct (ge := tprog.globalenv) (fn := tf) .RSP
        f0.fn_link_ofs Tptr .AX c1 rs c m' _ EQ0 A
      obtain ⟨rs2, S, T, U⟩ := loadind_correct (ge := tprog.globalenv) (fn := tf) .RAX ofs ty dst
        k rs1 c1 m' v' EQ (by
          show Mem.loadv _ m' (Val.offsetPtr (rs1 (pregOf .AX)) ofs) = _
          rw [Q]; exact C)
      refine ⟨rs2, exec_straight_trans P S, agree_set_mreg
        (AG1 (fun r' hd hne => R r' hd hne))
        (by rw [T]; exact D) U, ?_⟩
      intro h
      rw [U (.IR .RAX) rfl (DIFF h)]
      exact Q

/-- `step_simulation`, case `Mop`. -/
theorem step_Mop {s fb sp op args res c ms m v st}
    (MS : MatchStates prog.globalenv (.State s fb sp (.Mop op args res :: c) ms m) st)
    (H : Op.evalOperation prog.globalenv sp op (args.map ms) m = some v) :
    ∃ st', Smallstep.Plus (Asm.Step win64 tprog.globalenv) st E0 st' ∧
      MatchStates prog.globalenv
        (.State s fb sp c (Mach.Regset.set res v (Mach.undefRegs (destroyedByOp op) ms)) m) st' := by
  cases MS with
  | intro _ _ _ _ ep _ _ m' rs f tf tc STACKS FIND MEXT AT AG _ =>
    have H' : Op.evalOperation tprog.globalenv sp op (args.map ms) m = some v := by
      rw [Op.evalOperation_preserved prog.globalenv tprog.globalenv (symbols_preserved TRANSF)]
      exact H
    obtain ⟨v', A, B⟩ := Op.evalOperation_lessdef tprog.globalenv sp op (preg_vals AG args) MEXT H'
    rw [sp_val AG] at A
    refine exec_straight_steps TRANSF win64 STACKS MEXT FIND AT ?_
    intro k c TR
    simp only [translInstr] at TR
    obtain ⟨rs2, P, Q, R⟩ := transl_op_correct (ge := tprog.globalenv) (fn := tf) rs m' TR A
    exact ⟨rs2, P, agree_set_undef_mreg AG (Val.lessdef_trans B Q) R, fun h => by cases h⟩

/-- `step_simulation`, case `Mload`. -/
theorem step_Mload {s fb sp chunk addr args dst c ms m a v st}
    (MS : MatchStates prog.globalenv (.State s fb sp (.Mload chunk addr args dst :: c) ms m) st)
    (H : Op.evalAddressing prog.globalenv sp addr (args.map ms) = some a)
    (H1 : Mem.loadv chunk m a = some v) :
    ∃ st', Smallstep.Plus (Asm.Step win64 tprog.globalenv) st E0 st' ∧
      MatchStates prog.globalenv
        (.State s fb sp c (Mach.Regset.set dst v (Mach.undefRegs (destroyedByLoad chunk addr) ms)) m)
        st' := by
  cases MS with
  | intro _ _ _ _ ep _ _ m' rs f tf tc STACKS FIND MEXT AT AG _ =>
    have H' : Op.evalAddressing tprog.globalenv sp addr (args.map ms) = some a := by
      rw [Op.evalAddressing_preserved prog.globalenv tprog.globalenv (symbols_preserved TRANSF)]
      exact H
    obtain ⟨a', A, B⟩ := Op.evalAddressing_lessdef tprog.globalenv sp addr (preg_vals AG args) H'
    rw [sp_val AG] at A
    obtain ⟨v', C, D⟩ := Mem.loadv_extends MEXT H1 B
    refine exec_straight_steps TRANSF win64 STACKS MEXT FIND AT ?_
    intro k c TR
    simp only [translInstr] at TR
    obtain ⟨rs2, P, Q, R⟩ := transl_load_correct (ge := tprog.globalenv) (fn := tf) rs m' TR A C
    exact ⟨rs2, P, agree_set_undef_mreg AG (by rw [Q]; exact D) (fun r' hd hne _ => R r' hd hne),
      fun h => by cases h⟩

/-- `step_simulation`, case `Mstore`. -/
theorem step_Mstore {s fb sp chunk addr args src c ms m m2 a st}
    (MS : MatchStates prog.globalenv (.State s fb sp (.Mstore chunk addr args src :: c) ms m) st)
    (H : Op.evalAddressing prog.globalenv sp addr (args.map ms) = some a)
    (H1 : Mem.storev chunk m a (ms src) = some m2) :
    ∃ st', Smallstep.Plus (Asm.Step win64 tprog.globalenv) st E0 st' ∧
      MatchStates prog.globalenv
        (.State s fb sp c (Mach.undefRegs (destroyedByStore chunk addr) ms) m2) st' := by
  cases MS with
  | intro _ _ _ _ ep _ _ m' rs f tf tc STACKS FIND MEXT AT AG _ =>
    have H' : Op.evalAddressing tprog.globalenv sp addr (args.map ms) = some a := by
      rw [Op.evalAddressing_preserved prog.globalenv tprog.globalenv (symbols_preserved TRANSF)]
      exact H
    obtain ⟨a', A, B⟩ := Op.evalAddressing_lessdef tprog.globalenv sp addr (preg_vals AG args) H'
    rw [sp_val AG] at A
    obtain ⟨m2', C, D⟩ := Mem.storev_extends MEXT H1 B (preg_val AG src)
    refine exec_straight_steps TRANSF win64 STACKS D FIND AT ?_
    intro k c TR
    simp only [translInstr] at TR
    obtain ⟨rs2, P, Q⟩ := transl_store_correct (ge := tprog.globalenv) (fn := tf) rs m' TR A C
    exact ⟨rs2, P, agree_undef_regs AG Q, fun h => by cases h⟩

/-- `step_simulation`, case `Mcond` (branch taken). -/
theorem step_Mcond_true {s fb f0 sp cond args lbl c ms m c' st}
    (MS : MatchStates prog.globalenv (.State s fb sp (.Mcond cond args lbl :: c) ms m) st)
    (H : Op.evalCondition cond (args.map ms) m = some true)
    (H0 : Genv.findFunctPtr prog.globalenv fb = some (.Internal f0))
    (H1 : Mach.findLabel lbl f0.fn_code = some c') :
    ∃ st', Smallstep.Plus (Asm.Step win64 tprog.globalenv) st E0 st' ∧
      MatchStates prog.globalenv
        (.State s fb sp c' (Mach.undefRegs (destroyedByCond cond) ms) m) st' := by
  cases MS with
  | intro _ _ _ _ ep _ _ m' rs f tf tc STACKS FIND MEXT AT AG _ =>
    rw [FIND] at H0; cases H0
    have EC := Op.evalCondition_lessdef (preg_vals AG args) MEXT H
    refine exec_straight_steps_goto TRANSF win64 STACKS MEXT FIND H1 AT ?_
    intro k c TR
    simp only [translInstr] at TR
    obtain ⟨rs', A, B, C⟩ := transl_cond_correct (ge := tprog.globalenv) (fn := tf) rs m' TR
    rw [EC] at B
    obtain ⟨jmp, k', rs2, D, E, F⟩ := mk_jcc_true (ge := tprog.globalenv) (fn := tf)
      (testcondForCondition cond) lbl k rs' m' B.1
    exact ⟨jmp, k', rs2, exec_straight_opt_left A D,
      agree_undef_regs AG (fun r hd _ => (E r hd).trans (C r hd)), F⟩

/-- `step_simulation`, case `Mcond` (branch not taken). -/
theorem step_Mcond_false {s fb sp cond args lbl c ms m st}
    (MS : MatchStates prog.globalenv (.State s fb sp (.Mcond cond args lbl :: c) ms m) st)
    (H : Op.evalCondition cond (args.map ms) m = some false) :
    ∃ st', Smallstep.Plus (Asm.Step win64 tprog.globalenv) st E0 st' ∧
      MatchStates prog.globalenv
        (.State s fb sp c (Mach.undefRegs (destroyedByCond cond) ms) m) st' := by
  cases MS with
  | intro _ _ _ _ ep _ _ m' rs f tf tc STACKS FIND MEXT AT AG _ =>
    have EC := Op.evalCondition_lessdef (preg_vals AG args) MEXT H
    refine exec_straight_steps TRANSF win64 STACKS MEXT FIND AT ?_
    intro k c TR
    simp only [translInstr] at TR
    obtain ⟨rs', A, B, C⟩ := transl_cond_correct (ge := tprog.globalenv) (fn := tf) rs m' TR
    rw [EC] at B
    obtain ⟨rs2, D, E⟩ := mk_jcc_false (ge := tprog.globalenv) (fn := tf)
      (testcondForCondition cond) lbl k rs' m' B.1
    exact ⟨rs2, exec_straight_trans A D,
      agree_undef_regs AG (fun r hd _ => (E r hd).trans (C r hd)), fun h => by cases h⟩

end PRESERVATION

end Asmgenproof
end X86
end CC
